MYSQL_DATABASE=personal_workbench
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=pwb
MYSQL_PASSWORD=replace-with-a-long-random-password
# 仅使用 --profile bundled-db 启动容器 MySQL 时需要
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-login-password
TOKEN_SECRET=replace-with-at-least-32-random-characters
TOKEN_HOURS=168

WEB_PORT=8080
TZ=Asia/Hong_Kong
# Android App 跨域访问时填写正式站点来源，例如：https://workbench.example.com
CORS_ORIGINS=
